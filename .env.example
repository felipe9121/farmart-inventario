# Variables para docker-compose. Copiar a .env (ignorado por git) y cambiar la clave.
# SQL Server exige clave fuerte: >= 8 caracteres con mayúsculas, minúsculas, dígitos y símbolos.
MSSQL_SA_PASSWORD=CambiaEsta_Clave123!
MSSQL_PORT=1433

# Usuario con el que se conecta la app: solo lectura/escritura de datos, sin DDL.
MSSQL_APP_USER=farmart_app
MSSQL_APP_PASSWORD=CambiaEsta_ClaveApp123!

DB_DATABASE=farmart
DB_TEST_DATABASE=farmart_test

# Stack completo (docker compose up): clave de la app y puerto web.
# Generar APP_KEY con: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
WEB_PORT=8080
# true para cargar datos sintéticos de demostración (solo si la base está vacía).
SEED_DEMO=false

# Puerto del contenedor backend y UID/GID del usuario de WSL (para no crear archivos como root).
APP_PORT=8000
UID=1000
GID=1000
