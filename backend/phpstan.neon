includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Nivel 6: exige tipos en firmas y propiedades sin el ruido de genéricos estrictos (8+).
    level: 6
    paths:
        - app
        - config
        - database
        - routes
        - tests
    tmpDir: storage/framework/cache/phpstan
